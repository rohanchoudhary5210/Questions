class Main {

    public static void main(String[] args) {
        dutch();
    }

    public static void dutch() {
        int[] n = {1,0,0,1,1,2,1,0};

        int low = 0, mid = 0, high = n.length - 1;

        while(mid <= high){
            if(n[mid] == 0){
                swap(n, mid, low);
                low++;
                mid++;
            }
            else if(n[mid] == 1){
                mid++;
            }
            else{
                swap(n, high, mid);
                high--;
            }
        }

        arrayprint(n);
    }

    public static void swap(int[] n, int a, int b){
        int temp = n[a];
        n[a] = n[b];
        n[b] = temp;
    }

    public static void arrayprint(int[] n){
        for(int i = 0; i < n.length; i++){
            System.out.print(n[i] + " ");
        }
    }
}
