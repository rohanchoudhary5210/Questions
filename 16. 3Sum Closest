class Main {

    public static void main(String[] args) {
        int[] n={1,2,3,4,5,6};
        int t=16;
        int ans=three_sum_closest(n,t);
        System.out.println("closest to "+t+" is:"+ans);
    }

    public static int three_sum_closest(int[] n,int t) {
        int bestsum=n[0]+n[1]+n[2];
        for(int i=0;i<n.length-2;i++){
            int left=i+1;
            int right=n.length-1;
            while(left<right){
                int sum=n[i]+n[left]+n[right];
                if(Math.abs(bestsum-t)>Math.abs(sum-t))
                bestsum=sum;
                if(sum<t)
                left++;
                else if(sum>t)
                right--;
                else
                return sum;
            }
        }
        return bestsum;
    }
}
