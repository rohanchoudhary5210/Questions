 public static void main(String[] args) {
        int[] n={1,2,3,4,5,6};
        int t=9;
        int ans=three_sum_smaller(n,t);
        System.out.println("No. of smaller pairs is: "+ans);
    }

    public static int three_sum_smaller(int[] n,int t) {
        int pairs =0;
        for(int i=0;i<n.length-2;i++){
            int left=i+1,right=n.length-1;
            while(left<right){
                int sum=n[left]+n[right]+n[i];
                if(sum>=t)
                right--;
                else{
                    pairs=pairs+(right-left);
                    left++;
                }
            }
        }
        return pairs;
    }
